# Application Config
PROJECT_NAME="FastAPI Task Hub API"
API_V1_STR="/api/v1"
DEBUG=True

# PostgreSQL 16 connection exposed from Docker Compose to the host
DATABASE_URL="postgresql+asyncpg://task_hub:task_hub_dev_password@localhost:5432/task_hub"

# Docker Compose PostgreSQL Config
POSTGRES_DB="task_hub"
POSTGRES_USER="task_hub"
POSTGRES_PASSWORD="task_hub_dev_password"
POSTGRES_PORT=5432

# Redis Config
REDIS_URL="redis://localhost:6379/0"
REDIS_PORT=6379
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
REDIS_SOCKET_TIMEOUT=5.0
REDIS_HEALTH_CHECK_INTERVAL=30

# Security (Placeholder for secret keys if needed later)
SECRET_KEY="your-super-secret-key-change-this-in-production"
# Local HTTP development only; omit this override in production.
COOKIE_SECURE=False
